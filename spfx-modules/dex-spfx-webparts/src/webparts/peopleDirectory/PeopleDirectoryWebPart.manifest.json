    "group": { "default": "Advanced" },
    "title": { "default": "People Directory", "ko-kr": "조직도/직원 검색" },
    "description": { "default": "Search people across the organization via Microsoft Graph, with manager and direct reports.", "ko-kr": "Microsoft Graph 기반 직원 검색과 상급자/직속 구성원 조회를 제공합니다." },
    "officeFabricIconFontName": "People",
    "properties": {
      "title": "",
      "pageSize": 12
    }
  }]
}
